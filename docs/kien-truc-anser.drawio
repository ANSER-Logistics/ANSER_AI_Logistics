  </diagram>
  <diagram id="p2" name="2. Lựa chọn model">
    <mxGraphModel dx="2841" dy="1044" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" parent="1" style="text;html=1;fontSize=24;fontStyle=1;align=left;" value="2. Bốn model, và vì sao chọn từng cái" vertex="1">
          <mxGeometry height="34" width="800" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="t2b" parent="1" style="text;html=1;fontSize=13;fontColor=#5a5a5a;align=left;" value="Nguyên tắc chung: LLM chỉ làm hai việc, đọc tiếng Việt thành cấu trúc và diễn giải cấu trúc thành câu. Nó không tính toán. Vì vậy model 8B là đủ, và kích thước model không phải thứ quyết định độ rộng nghiệp vụ." vertex="1">
          <mxGeometry height="24" width="1200" x="40" y="66" as="geometry" />
        </mxCell>
        <mxCell id="m1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#4a7fb5;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;TEXT — Qwen3-8B&lt;/b&gt;  (AWQ 4-bit)&lt;br&gt;&lt;br&gt;Việc: gọi tool, diễn giải kết quả, sinh workflow n8n, trích xuất yêu cầu báo giá&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao 8B và không to hơn:&lt;/b&gt;&lt;br&gt;• Qwen3-30B-A3B cần ~19-21GB Q4 → không còn chỗ cho vision. OCR hoá đơn là tính năng cốt lõi, không đánh đổi được&lt;br&gt;• Qwen3-14B AWQ ~9GB: vừa 24GB nhưng khoá chặt vào bậc T1+&lt;br&gt;• Qwen3-8B: tool-calling gốc, vừa mọi bậc T0→T3&lt;br&gt;&lt;br&gt;&lt;b&gt;Hai bản:&lt;/b&gt; gốc Qwen/Qwen3-8B · fine-tune anser-v3-awq&lt;br&gt;&lt;i&gt;Kết luận 15/08: nhánh kế toán dùng bản gốc; nhánh vận tải (extraction) bản fine-tune thắng áp đảo&lt;/i&gt;" vertex="1">
          <mxGeometry height="250" width="620" x="40" y="120" as="geometry" />
        </mxCell>
        <mxCell id="m2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#4a7fb5;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;VISION — Qwen2.5-VL-3B-Instruct&lt;/b&gt;  (bf16)&lt;br&gt;&lt;br&gt;Việc: đọc ảnh hoá đơn nhà xe, hoá đơn giấy&lt;br&gt;&lt;br&gt;&lt;b&gt;KHÔNG lượng tử hoá xuống 4-bit.&lt;/b&gt; Việc của nó là đọc đúng con số tiền trên tờ giấy nhàu — đúng loại tác vụ mất mát lượng tử hoá gây hại nhất, và dự án chưa có bộ ảnh thật nào để đo xem mất bao nhiêu.&lt;br&gt;&lt;i&gt;RAG_VLM_KE_HOACH §B.2.4&lt;/i&gt;&lt;br&gt;&lt;br&gt;Ứng viên chưa thử: &lt;b&gt;Vintern-1B&lt;/b&gt;, làm riêng cho tiếng Việt, 3tr cặp ảnh-hỏi-đáp. 1B so với 3B là khác biệt lớn về VRAM. Phải ĐO trên 20-30 ảnh thật trước khi đổi." vertex="1">
          <mxGeometry height="250" width="620" x="690" y="120" as="geometry" />
        </mxCell>
        <mxCell id="m3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;EMBEDDER — BAAI/bge-m3&lt;/b&gt;  (MIT)&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao đổi khỏi MiniLM:&lt;/b&gt; MiniLM cũ giới hạn 128 token nên &lt;b&gt;cắt cụt IM LẶNG&lt;/b&gt; quá nửa mỗi đoạn. bge-m3 nhận tới 8192 token.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chạy CPU&lt;/b&gt; — truy vấn RAG thưa, vài lượt mỗi phút chứ không phải mỗi token. Đổi ~200ms độ trễ lấy 1,2GB VRAM là hời." vertex="1">
          <mxGeometry height="180" width="620" x="40" y="400" as="geometry" />
        </mxCell>
        <mxCell id="m4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;RERANKER — namdp-ptit/ViRanker&lt;/b&gt;  (Apache-2.0)&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao đổi khỏi ms-marco:&lt;/b&gt; ms-marco là model &lt;b&gt;tiếng Anh&lt;/b&gt;, mà điểm của nó lại dùng làm &lt;b&gt;ngưỡng lọc&lt;/b&gt; cho tài liệu tiếng Việt.&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao không dùng jina-reranker-v2:&lt;/b&gt; giấy phép CC-BY-NC-4.0, cấm dùng thương mại.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chạy CPU&lt;/b&gt;, cùng lý do với embedder." vertex="1">
          <mxGeometry height="180" width="620" x="690" y="400" as="geometry" />
        </mxCell>
        <mxCell id="m5" parent="1" style="text;html=1;fontSize=17;fontStyle=1;align=left;" value="&lt;b&gt;Ba thứ KHÔNG dùng, và vì sao&lt;/b&gt;" vertex="1">
          <mxGeometry height="26" width="500" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="x1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;LLM bên thứ ba&lt;/b&gt; (OpenAI, Gemini, Claude, DeepSeek)&lt;br&gt;&lt;br&gt;Vi phạm R2. Dữ liệu khách gồm tồn kho, doanh thu, công nợ, &lt;b&gt;bảng giá cước&lt;/b&gt;, &lt;b&gt;tỷ lệ biên&lt;/b&gt;, danh sách khách, nội dung hoá đơn.&lt;br&gt;&lt;br&gt;Ngoại lệ duy nhất: sinh dữ liệu huấn luyện từ &lt;b&gt;corpus công khai&lt;/b&gt; (nghị định), và judge chạy trên dữ liệu tổng hợp." vertex="1">
          <mxGeometry height="200" width="410" x="40" y="645" as="geometry" />
        </mxCell>
        <mxCell id="x2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Text-to-SQL cho báo cáo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Số tài chính sai mà nghe hợp lý là loại lỗi tệ nhất: không ai phát hiện tới lúc quyết toán.&lt;br&gt;&lt;br&gt;Thay bằng: tool có tham số ràng buộc, SQL viết sẵn, engine tất định tính rồi LLM chỉ diễn giải.&lt;br&gt;&lt;br&gt;&lt;i&gt;250 mẫu text-to-SQL của module_b bị bỏ có chủ đích.&lt;/i&gt;" vertex="1">
          <mxGeometry height="200" width="410" x="480" y="645" as="geometry" />
        </mxCell>
        <mxCell id="x3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Giá dầu / công nợ / tồn kho trong RAG&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giá dầu đổi chiều thứ Năm hằng tuần (NĐ 80/2023, ~52 kỳ/năm). Nhúng vào vector DB nghĩa là embedding của giá cũ nằm lại vĩnh viễn và vẫn được truy hồi ra.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ranh giới:&lt;/b&gt; RAG cho văn bản cần &lt;i&gt;tìm kiếm&lt;/i&gt;; tool cho con số cần &lt;i&gt;tra cứu&lt;/i&gt;." vertex="1">
          <mxGeometry height="200" width="390" x="920" y="645" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdfbf0;strokeColor=#c9b23f;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Fine-tune: v2 nghỉ hưu, v3 là pipeline hiện hành&lt;/b&gt;&lt;br&gt;&lt;br&gt;v2 (anser-retail-v2-awq) không dùng lại — không phải vì code tệ mà vì dữ liệu dạy ngược kiến trúc mới: system prompt cũ, ép &amp;lt;think&amp;gt; ở mọi câu (xung đột trực tiếp với guided_json vì grammar ép &quot;{&quot; là token đầu), 24 mẫu Make.com, và loss tính trên cả prompt.&lt;br&gt;&lt;br&gt;&lt;b&gt;v3 dùng reverse-generation:&lt;/b&gt; sinh JSON ground truth tất định TRƯỚC, teacher chỉ viết tin nhắn tự nhiên chứa đúng thông tin đó, rồi verify tất định. Nhãn đúng tuyệt đối theo cấu trúc, không phải tin teacher." vertex="1">
          <mxGeometry height="160" width="1270" x="40" y="880" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="3. VRAM + bậc hạ tầng">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="3. Ngân sách VRAM trên L4 22,5GB, và bốn bậc hạ tầng" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t3b" value="Bảng ở ARCHITECTURE.md §5.1 đã LỖI THỜI (ghi vision AWQ 3,0GB, tổng 15,0GB). Mã nạp vision bf16. Bảng dưới là bảng đúng, tính lại 03/08/2026." style="text;html=1;fontSize=13;fontColor=#c0392b;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="bar" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5a6570;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1125" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;vLLM&lt;/b&gt;&lt;br&gt;gpu_memory_utilization = 0.55&lt;br&gt;&lt;b&gt;12,4 GB&lt;/b&gt; — GIỮ CHỖ CỨNG&lt;br&gt;(weights ~6GB + KV cache)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#4a7fb5;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="620" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;Vision bf16&lt;/b&gt;&lt;br&gt;Qwen2.5-VL-3B&lt;br&gt;&lt;b&gt;~7,5 GB&lt;/b&gt;&lt;br&gt;(3,75B × 2 byte)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c5cae9;strokeColor=#5c6bc0;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="130" width="375" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;đệm&lt;/b&gt;&lt;br&gt;~2,6 GB&lt;br&gt;activation&lt;br&gt;+ phân mảnh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#9aa3ad;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1035" y="130" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;22,5 GB&lt;/b&gt;" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="1175" y="165" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cpu" value="&lt;b&gt;Đã đẩy sang CPU để lấy lại 2,4 GB:&lt;/b&gt;  bge-m3 (~1,2GB) + ViRanker (~1,2GB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=middle;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="kv" value="&lt;b&gt;Đánh đổi thật: ctx so với số request đồng thời&lt;/b&gt;&lt;br&gt;&lt;br&gt;KV cache Qwen3-8B ≈ 2 × 36 lớp × 8 đầu KV × 128 head_dim × 2 byte&lt;br&gt;&lt;b&gt;≈ 0,147 MB mỗi token&lt;/b&gt;&lt;br&gt;&lt;br&gt;Một chuỗi dài trọn 32k  →  ~4,6 GB&lt;br&gt;Cộng ~6 GB weights  →  ~10,6 GB trong bể 12,4 GB&lt;br&gt;&lt;br&gt;&lt;b&gt;Nghĩa là ở 32k, bể KV gần như chỉ đủ MỘT chuỗi dài trọn vẹn&lt;/b&gt;, và continuous batching của vLLM chỉ phát huy khi còn chỗ cho nhiều chuỗi.&lt;br&gt;&lt;br&gt;&lt;i&gt;Đây là ƯỚC LƯỢNG. BR-04 của SRS chu kỳ 01 phải xác nhận bằng dòng &quot;GPU KV cache size&quot; vLLM in lúc khởi động.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeedb;strokeColor=#c9913f;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="560" height="270" as="geometry" />
        </mxCell>
        <mxCell id="why" value="&lt;b&gt;Vì sao L4 là sàn, T4 16GB không đủ&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vision bf16 một mình đã 7,5GB. Cộng bể vLLM đủ cho weights 6GB và một ít KV cache thì đã vượt 16GB trước khi tính đệm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nếu 32k không vừa, thứ tự xử (chốt 24/10):&lt;/b&gt;&lt;br&gt;1. Hạ gpu_memory_utilization rồi đo lại — weights AWQ chỉ ~6GB nên phần giữ chỗ 12,4GB có thể rộng hơn mức cần&lt;br&gt;2. Rồi mới hạ max_model_len&lt;br&gt;&lt;br&gt;&lt;b&gt;KHÔNG tách vision sang tiến trình riêng&lt;/b&gt;, vì cần dựng lại được môi trường giả lập production để thử Brain.&lt;br&gt;&lt;br&gt;Ctx chọn ra phải đủ cho &lt;b&gt;một kế hoạch 3 tool kèm đoạn RAG&lt;/b&gt; (MAX_PLAN=3, DEFAULT_MAX_STEPS=4), đo bằng ca thật chứ không chọn theo số tròn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="310" width="535" height="270" as="geometry" />
        </mxCell>
        <mxCell id="t3c" value="Bốn bậc hạ tầng, gắn với doanh thu — trần R3 là 5.000.000đ/tháng cho pilot miễn phí" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="T0" value="&lt;b&gt;T0&lt;/b&gt; — pilot miễn phí&lt;br&gt;&lt;br&gt;RTX 3090 24GB&lt;br&gt;&lt;b&gt;bật theo giờ hành chính&lt;/b&gt;&lt;br&gt;~10h × 22 ngày = 220h&lt;br&gt;&lt;br&gt;&lt;b&gt;~750.000đ/tháng&lt;/b&gt;&lt;br&gt;= 15% trần&lt;br&gt;&lt;br&gt;&lt;i&gt;Khách là DN 4-5 người làm giờ hành chính. Job đêm chạy bằng n8n thuần, không cần GPU.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="270" height="250" as="geometry" />
        </mxCell>
        <mxCell id="T1" value="&lt;b&gt;T1&lt;/b&gt; — 1-3 khách trả phí&lt;br&gt;&lt;br&gt;RTX 3090 24GB&lt;br&gt;&lt;b&gt;24/7&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;~2.500.000đ/tháng&lt;/b&gt;&lt;br&gt;vẫn dưới trần 5tr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="660" width="270" height="250" as="geometry" />
        </mxCell>
        <mxCell id="T2" value="&lt;b&gt;T2&lt;/b&gt; — 5-10 khách trả phí&lt;br&gt;&lt;br&gt;RTX 4090 24GB 24/7&lt;br&gt;hoặc 2× 3090&lt;br&gt;&lt;br&gt;&lt;b&gt;~6.300.000đ/tháng&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Doanh thu lúc này 75-150tr/tháng → hạ tầng chiếm 4-8%&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="660" width="270" height="250" as="geometry" />
        </mxCell>
        <mxCell id="T3" value="&lt;b&gt;T3&lt;/b&gt; — dòng tiền ổn định&lt;br&gt;&lt;br&gt;&lt;b&gt;Máy tự sở hữu&lt;/b&gt;&lt;br&gt;RTX 3090/4090 24GB&lt;br&gt;&lt;br&gt;~15-18tr một lần&lt;br&gt;+ ~600.000đ điện/tháng&lt;br&gt;&lt;br&gt;Hoàn vốn ~6-7 tháng so với T1&lt;br&gt;&lt;br&gt;&lt;b&gt;Điều kiện để tuyên bố R2 đầy đủ với khách.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#4a7fb5;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="660" width="270" height="250" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="&lt;b&gt;Nói thật với khách về chủ quyền dữ liệu&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPU thuê trên marketplace cộng đồng là &lt;b&gt;máy của người lạ&lt;/b&gt;. Weights và dữ liệu nằm trong VRAM/RAM/disk của họ, không có hợp đồng bảo mật. Xét thuần về chủ quyền dữ liệu, mức bảo vệ này &lt;i&gt;thấp hơn&lt;/i&gt; API thương mại có điều khoản zero-retention.&lt;br&gt;&lt;br&gt;Ở T0/T1, R2 chỉ thoả mãn &lt;b&gt;một phần&lt;/b&gt;. &lt;b&gt;Không quảng cáo &quot;dữ liệu không rời hệ thống&quot; trước khi đạt T3.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Giảm thiểu bắt buộc: ưu tiên nhà cung cấp có datacenter riêng; không để dữ liệu khách nằm lại trên đĩa GPU host; mã hoá kênh Brain↔Body; xoay token định kỳ." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdeedb;strokeColor=#c9913f;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1140" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="4. Hạ tầng: hiện trạng vs đích">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t4" value="4. Hạ tầng phục vụ model: hiện trạng và đích (S2)" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="h1" value="&lt;b&gt;HIỆN TRẠNG&lt;/b&gt; — model nạp TRONG tiến trình Brain" style="text;html=1;fontSize=17;fontStyle=1;align=left;fontColor=#c0392b;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="chat.py → manager → ModelEngine.generate_chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="tokenizer = self.llm.get_tokenizer()&lt;br&gt;apply_chat_template(enable_thinking=False)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=middle;spacing=10;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;run_in_executor&lt;/b&gt; → &lt;b&gt;vllm.LLM.generate()&lt;/b&gt;&lt;br&gt;&lt;br&gt;API chạy lô NGOẠI TUYẾN. Mỗi lệnh chạy trọn một vòng lập lịch cho đúng lô đưa vào. Một prompt = lô kích thước một.&lt;br&gt;&lt;br&gt;&lt;b&gt;→ continuous batching bị vô hiệu hoá hoàn toàn&lt;/b&gt;&lt;br&gt;&lt;b&gt;→ nhiều luồng cùng gọi một object không thread-safe&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đây là nguyên nhân hiện tượng &quot;quá tải, treo&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="arr" value="S2" style="shape=mxgraph.arrows2.arrow;dy=0.6;dx=40;notch=0;html=1;fillColor=#5a9a5a;strokeColor=#3f7a3f;fontSize=20;fontStyle=1;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="370" y="250" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;ĐÍCH&lt;/b&gt; — vLLM chạy tiến trình riêng, Brain gọi qua HTTP" style="text;html=1;fontSize=17;fontStyle=1;align=left;fontColor=#3f7a3f;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="700" height="26" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="chat.py → manager → ModelEngine.generate_chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="130" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;VLLMServerClient&lt;/b&gt;  (src/core/serving.py)&lt;br&gt;ConcurrencyGuard · CompletionRequest(guided_json)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=middle;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="HTTP&lt;br&gt;127.0.0.1:8001" style="text;html=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="880" y="205" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;vllm serve Qwen3-8B&lt;/b&gt;&lt;br&gt;tiến trình riêng, cổng 8001&lt;br&gt;&lt;br&gt;&lt;b&gt;Lợi:&lt;/b&gt;&lt;br&gt;• continuous batching THẬT&lt;br&gt;• restart Brain không nạp lại 6GB weights&lt;br&gt;• nâng cấp vLLM độc lập với Brain&lt;br&gt;• vLLM sập thì /health và /tools/* vẫn sống&lt;br&gt;&lt;br&gt;&lt;b&gt;Mất:&lt;/b&gt; một chặng mạng nội bộ ~1ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="160" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="e41" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e43" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="d2" target="d3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e44" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a9a5a;strokeWidth=2;" edge="1" parent="1" source="d3" target="d5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="&lt;b&gt;TRẠNG THÁI THẬT, 24/10/2026: lớp bên phải ĐÃ VIẾT XONG VÀ KHÔNG AI GỌI NÓ&lt;/b&gt;" style="text;html=1;fontSize=17;fontStyle=1;align=left;fontColor=#c0392b;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="1100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="gap2" value="grep -rn &quot;VLLMServerClient&quot; --include=*.py src/ tests/&lt;br&gt;&amp;nbsp;&amp;nbsp;src/core/serving.py:241   class VLLMServerClient:&lt;br&gt;&amp;nbsp;&amp;nbsp;tests/test_serving.py     (6 chỗ)&lt;br&gt;&lt;br&gt;engine.py import từ serving ĐÚNG MỘT THỨ: guard_from_env.&lt;br&gt;&lt;br&gt;Đây là lần thứ TƯ dự án dính hình dạng lỗi &quot;một lớp phòng thủ trông như đã có mà chưa nối&quot;. Ba lần trước: API_TOKEN vs API_AUTH_TOKEN · arguments_schema() không đóng object · trần token benchmark rộng hơn production.&lt;br&gt;&lt;br&gt;test_deploy_config.py KHÔNG bắt được: nó quét regex, thấy os.getenv(&quot;VLLM_BASE_URL&quot;) nằm trong chính serving.py, rồi kết luận biến đã được mã đọc. &lt;b&gt;Đọc khác dùng.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="545" width="560" height="245" as="geometry" />
        </mxCell>
        <mxCell id="trap" value="&lt;b&gt;BA CÁI BẪY trong đường server — mỗi cái một yêu cầu kèm phép thử&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Chat template.&lt;/b&gt; Client chỉ có complete() gọi /v1/completions với prompt THÔ. Không có hàm chat. Đường trong tiến trình lấy template từ tokenizer của chính đối tượng vllm.LLM.&lt;br&gt;&lt;b&gt;→ phải dùng /v1/chat/completions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2. enable_thinking=False.&lt;/b&gt; Đặt ở engine.py:358, đường server chưa có. Qwen3 mặc định BẬT thinking, mà grammar ép &quot;{&quot; là token đầu và dataset v3 train KHÔNG think.&lt;br&gt;&lt;b&gt;→ phải truyền chat_template_kwargs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;3. repetition_penalty.&lt;/b&gt; Hạ 1,25→1,0 khi bật grammar ở engine.py:341. CompletionRequest mặc định 1,25 và không chỗ nào hạ. JSON BẮT BUỘC lặp token (&quot;typeVersion&quot;, &quot;position&quot;, dấu ngoặc).&lt;br&gt;&lt;br&gt;&lt;i&gt;Bẫy 2 và 3 không làm chương trình đổ. Chúng làm chất lượng sinh tụt im lặng — loại đã đốt trọn một vòng đo ngày 15/08.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeedb;strokeColor=#c9913f;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="545" width="690" height="310" as="geometry" />
        </mxCell>
        <mxCell id="prof" value="&lt;b&gt;Ba hồ sơ chạy — biến RUNTIME_PROFILE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;full&lt;/b&gt; (mặc định) — text + vision + RAG. Máy dev, Colab.&lt;br&gt;&lt;b&gt;text-only&lt;/b&gt; — text + RAG, tắt vision. Chưa dùng.&lt;br&gt;&lt;b&gt;minimal&lt;/b&gt; — KHÔNG nạp model nào.&lt;br&gt;&lt;br&gt;&lt;b&gt;Kiểm 24/10 với minimal:&lt;/b&gt;&lt;br&gt;/health → runtime_profile minimal, auth_enabled true, engine_ready false&lt;br&gt;/tools không token → 401 · có token → 200&lt;br&gt;/tools/inventory-audit → 2 phát hiện, money_impact 1.218.356đ&lt;br&gt;&lt;br&gt;&lt;b&gt;Nghĩa là lớp ra tiền triển khai được lên một máy CPU rẻ tiền, không chờ GPU.&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdfbf0;strokeColor=#c9b23f;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="chua" value="&lt;b&gt;Ba phần compose khai mà mã CHƯA làm&lt;/b&gt;  — khoá bằng tests/test_deploy_config.py&lt;br&gt;&lt;br&gt;1. &lt;b&gt;redis&lt;/b&gt; — container chạy, không mã nào dùng. TASK_REGISTRY vẫn là OrderedDict trong RAM. Restart là mất task đang chạy, và KHÔNG được nâng --workers của uvicorn.&lt;br&gt;2. &lt;b&gt;vllm-vision&lt;/b&gt; — chưa có client HTTP cho vision. Vision vẫn nạp thẳng trong tiến trình qua transformers.&lt;br&gt;3. Vì (2), &lt;b&gt;brain KHÔNG thật sự chạy được bằng CPU&lt;/b&gt; khi bật nhánh vision.&lt;br&gt;&lt;br&gt;Thêm: compose đặt ENV=SERVER mà mã chỉ rẽ nhánh ở == &quot;LOCAL&quot;, và khối environment của brain không đặt TEXT_MODEL_ID." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdfbf0;strokeColor=#c9b23f;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="630" y="880" width="690" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="5. Quy trình /chat">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t5" value="5. Quy trình POST /chat — tám bước, và chỗ ranh giới R1 nằm" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t5b" value="Model còn đúng hai việc: điền tham số cho tool đã chọn sẵn, và viết câu trả lời từ kết quả tool. Chọn tool, chạy tool, và lấy dữ liệu đều là code tất định." style="text;html=1;fontSize=13;fontColor=#5a5a5a;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1. Trả ngay task_id, xử lý chạy nền&lt;/b&gt;&lt;br&gt;Ghi chủ sở hữu vào registry TRƯỚC khi chạy nền." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1n" value="GET /api/v1/task/{id} sai chủ trả &lt;b&gt;404&lt;/b&gt;, không trả 403. 403 xác nhận task CÓ TỒN TẠI, tức biến endpoint thành máy dò task id hợp lệ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfbf0;strokeColor=#c9b23f;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. Đọc lịch sử hội thoại&lt;/b&gt;&lt;br&gt;_load_history(user_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s2n" value="Thiếu nó thì mỗi tin nhắn là một phiên độc lập, và câu &quot;thế xe 3 tấn thì sao?&quot; không hiểu được. DB lỗi thì trả [] và Brain vẫn trả lời, chỉ mất ngữ cảnh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d4d8;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="190" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. SemanticRouter chọn 1 trong 7 nhánh&lt;/b&gt;&lt;br&gt;từ khoá → cosine → kiểm biên" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3n" value="LOGISTICS · TECHNICAL · REPORT · EXPLAIN · DATA_INTERNAL · RETRIEVAL · GENERAL&lt;br&gt;Biên hẹp thì hạ về GENERAL chứ không đoán bừa. Thiếu embedder thì lùi về lớp từ khoá và TỰ KHAI BÁO qua method=&quot;keyword_only_degraded&quot;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d4d8;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. plan_tools: chọn tool bằng LUẬT&lt;/b&gt;&lt;br&gt;tool_planner.py · regex · trần 3 tool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4n" value="&quot;có nên nhập thêm hàng không&quot; LUÔN ứng với forecast_reorder. Không ngữ cảnh nào làm nó thành tool khác, nên đây là bảng tra chứ không phải việc cần model. Benchmark đo khâu &quot;model tự chọn tool&quot; chỉ đúng 26-33%." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d4d8;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="350" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. AgenticLoop — hai chốt chặn ở tầng SAMPLING&lt;/b&gt;&lt;br&gt;&lt;br&gt;còn kế hoạch → enum tool thu về ĐÚNG MỘT tên&lt;br&gt;còn kế hoạch → nhánh answer KHÔNG có trong lược đồ,&lt;br&gt;chỉ còn tool và hoi_lai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s5n" value="&lt;b&gt;Sự cố 23/08/2026.&lt;/b&gt; Câu soát hoá đơn có kế hoạch [&quot;vat&quot;] nhưng tool_calls = 0. Model tự nhẩm 5.000.000 + 500.000 rồi so với 6.500.000 trong đầu. &lt;b&gt;Lần đó ra ĐÚNG&lt;/b&gt;, và đó mới là chỗ nguy: một con số model tự tính thì lần sau sai cũng không có gì báo.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cấm tiệt cả hai nhánh lại sai theo cách khác:&lt;/b&gt; &quot;tính thuế giúp tôi&quot; không kèm số tiền mà bị ép gọi vat thì model phải BỊA stated_total — đổi một lỗi R1 lấy một lỗi R1 khác, mà lỗi sau tệ hơn vì số bịa đi qua tool nên trông như &quot;có nguồn&quot;.&lt;br&gt;&lt;b&gt;Nên chia đôi: đủ tham số thì gọi tool, thiếu thì hoi_lai.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeedb;strokeColor=#c9913f;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. data_provider bơm dữ liệu thật và GHI ĐÈ&lt;/b&gt;&lt;br&gt;&lt;br&gt;report cần dòng bán hàng, inventory_audit cần bảng tồn kho.&lt;br&gt;Chưa có nguồn thì vòng lặp DỪNG và nói thẳng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s6n" value="&lt;b&gt;Vì sao phải GHI ĐÈ chứ không hợp nhất:&lt;/b&gt; chốt chặn neo số liệu chỉ đối chiếu CÂU TRẢ LỜI với KẾT QUẢ TOOL. Nếu số bịa lọt vào từ ĐẦU VÀO thì mọi con số sau đó đều &quot;có nguồn&quot; và đi lọt hết.&lt;br&gt;&lt;br&gt;SYSTEM_DATA_FIELDS cũng quyết định hình dạng JSON Schema đưa vào guided decoding: để arguments trống thì model ngồi viết ra nguyên mảng sales — thứ data_provider vứt đi ngay sau đó, mà mảng dài làm JSON chạm trần token rồi cắt cụt, _parse trả None, vòng lặp gãy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d4d8;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="&lt;b&gt;7. guard_answer — chốt chặn neo số liệu&lt;/b&gt;&lt;br&gt;&lt;br&gt;mọi số ≥ 4 chữ số trong câu trả lời phải có trong dữ liệu gốc.&lt;br&gt;Chặn thì thay bằng câu an toàn và ghi log." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7n" value="CHỈ chạy khi có grounding_ctx. Nhánh GENERAL và LOGISTICS không có, và chặn ở đó là chặn oan cả con số người dùng vừa tự nhắc trong câu hỏi.&lt;br&gt;&lt;br&gt;&lt;b&gt;Hàm này tồn tại từ lâu và chạy ở HAI chỗ&lt;/b&gt; — lọc dữ liệu huấn luyện và chấm điểm benchmark — &lt;b&gt;nhưng tới 05/08/2026 mới được nối vào chỗ thứ ba, chỗ lúc phục vụ.&lt;/b&gt; Nghĩa là dự án đo được model bịa số 8-10 ca trên 27, rồi vẫn để con số bịa đó đi thẳng ra màn hình chủ doanh nghiệp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeedb;strokeColor=#c9913f;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="670" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8. Ghi metric, lưu lượt, gọi webhook về Body&lt;/b&gt;&lt;br&gt;ai_metrics_log.jsonl · TASK_REGISTRY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="780" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s8n" value="Nội dung tin nhắn chỉ ghi khi bật AI_METRICS_LOG_CONTENT=1. Biên lợi nhuận và secret LUÔN bị che." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d4d8;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="780" width="760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a9a5a;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a9a5a;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a9a5a;strokeWidth=2;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c0392b;strokeWidth=2;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r1n" value="&lt;b&gt;R1 — Deterministic-first.&lt;/b&gt; Ranh giới nằm ở bước 4, 5 và 6. Kiểm nhanh trước mỗi commit: &lt;i&gt;nếu model đọc sai một chữ số, có bản ghi sổ sách nào sai theo không?&lt;/i&gt; Nếu có, thiếu lớp tất định." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=top;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="1280" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p6" name="6. Quy trình soi sổ sách">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t6" value="6. Luồng ra tiền: một file Excel thành danh sách phát hiện" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1000" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t6b" value="Không có model nào tham gia. Đây là luồng đã chạy trên 6 file MISA thật và ra kết quả khách kiểm tay được." style="text;html=1;fontSize=13;fontColor=#5a5a5a;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p6a" value="&lt;b&gt;Kế toán&lt;/b&gt;&lt;br&gt;tải lên .xlsx&lt;br&gt;xuất từ MISA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6b" value="&lt;b&gt;tools.py&lt;/b&gt;&lt;br&gt;/tools/inventory-import&lt;br&gt;&lt;b&gt;file ở RAM, không ghi đĩa&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6c" value="&lt;b&gt;inventory_import.py&lt;/b&gt;&lt;br&gt;tìm header, map cột&lt;br&gt;ba lớp tự kiểm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6d" value="&lt;b&gt;inventory.py&lt;/b&gt;&lt;br&gt;audit_inventory&lt;br&gt;bất đẳng thức số học" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p6e" value="&lt;b&gt;findings&lt;/b&gt;&lt;br&gt;hình dạng dùng chung&lt;br&gt;Body chỉ cần 1 component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="p6a" target="p6b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="p6b" target="p6c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="p6c" target="p6d">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="p6d" target="p6e">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lop3" value="&lt;b&gt;Ba lớp tự kiểm — không lớp nào tự sửa dữ liệu&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Đơn giá bình quân có sẵn trong file phải khớp &lt;b&gt;giá_trị / số_lượng&lt;/b&gt; tính lại&lt;br&gt;2. Dòng &quot;Tổng cộng&quot; của chính file phải khớp tổng cộng lại — &lt;i&gt;file tự tố cáo chính nó&lt;/i&gt;&lt;br&gt;3. ĐK + Nhập − Xuất = CK, trên từng dòng&lt;br&gt;&lt;br&gt;&lt;b&gt;Ô rỗng trả None, không trả 0.0.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfbf0;strokeColor=#c9b23f;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="250" width="460" height="170" as="geometry" />
        </mxCell>
        <mxCell id="bon" value="&lt;b&gt;Bốn trường bắt buộc của một phát hiện&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;title&lt;/b&gt; — cái gì sai, bằng tiếng Việt thường&lt;br&gt;&lt;b&gt;evidence&lt;/b&gt; — số để mở MISA đối chiếu tay, không phải để trang trí&lt;br&gt;&lt;b&gt;money_impact&lt;/b&gt; — quy ra tiền, hoặc None khi thành thật là không quy được&lt;br&gt;&lt;b&gt;suggestion&lt;/b&gt; — việc cần làm tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="250" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="kq" value="&lt;b&gt;Sáu phép kiểm, và chúng tìm ra gì trên sổ thật của Hoàng Phát&lt;/b&gt;" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="&lt;b&gt;Tồn kho&lt;/b&gt;&lt;br&gt;2 mã âm&lt;br&gt;&lt;b&gt;5.596.500đ&lt;/b&gt; giá vốn không được ghi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k2" value="&lt;b&gt;Đối chiếu hai kỳ&lt;/b&gt;&lt;br&gt;chứng từ sửa hồi tố, 108 lít chạy từ mã này sang mã kia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k3" value="&lt;b&gt;Thuế suất GTGT&lt;/b&gt;&lt;br&gt;&lt;b&gt;157/160 mã&lt;/b&gt; để sai diện thuế theo NĐ 174/2025" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k4" value="&lt;b&gt;Công nợ&lt;/b&gt;&lt;br&gt;phải thu &lt;b&gt;3,96 tỷ&lt;/b&gt; = 113 ngày giá vốn; 3 khách giữ 66%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k5" value="&lt;b&gt;Mã số thuế&lt;/b&gt;&lt;br&gt;114 mã kiểm được&lt;br&gt;&lt;b&gt;0 sai, 0 báo oan&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k6" value="&lt;b&gt;Hàng chết&lt;/b&gt;&lt;br&gt;29 mã, ~161 triệu nằm im" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="490" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="h6" value="&lt;b&gt;Hai bài học đắt tiền đã khắc vào thiết kế luồng này&lt;/b&gt;" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="h6a" value="&lt;b&gt;1. Parser đọc đúng mọi thứ, trừ các cột số&lt;/b&gt;&lt;br&gt;&lt;br&gt;MISA đặt nhóm cột (Đầu kỳ / Nhập kho) CÙNG DÒNG với Mã hàng, còn tên cột con (Số lượng / Giá trị) ở DÒNG KẾ TIẾP — ngược với giả định ban đầu.&lt;br&gt;&lt;br&gt;Hậu quả: đọc đúng tên kho, kỳ, mã hàng, tên hàng, nhưng &lt;b&gt;không map được cột số nào&lt;/b&gt; → ra 119 dòng với mọi con số bằng 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;Và ok vẫn trả True&lt;/b&gt;, vì mismatches rỗng — mà mismatches rỗng chính VÌ không có cột nào để đối chiếu. Im lặng đúng lúc cần hét to nhất.&lt;br&gt;&lt;br&gt;&lt;i&gt;Sửa: _find_header nhận cả hai bố trí, và ok tính thêm missing_columns.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="630" height="280" as="geometry" />
        </mxCell>
        <mxCell id="h6b" value="&lt;b&gt;2. Một phép kiểm đã bị GỠ vì nó SAI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bản đầu kiểm: &quot;đơn giá tồn cuối cao hơn mọi giá đầu vào ⇒ sổ ghi sai giá vốn ⇒ lãi bị thổi lên&quot;. Lập luận nghe rất chắc.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lập luận đúng, dữ liệu đầu vào của nó thì không.&lt;/b&gt; in_value/in_qty là giá nhập BÌNH QUÂN CẢ KỲ, không phải giá từng lô. Với FIFO và giá tăng dần, hàng bán ra là lô cũ rẻ còn hàng nằm lại là lô mới đắt.&lt;br&gt;&lt;br&gt;Chạy trên 119 mã thật: gắn cờ &lt;b&gt;18 mã, cả 18 đều vô tội&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nguyên tắc rút ra: khi một quy tắc bắn trên hàng chục mã cùng lúc thì NGHI QUY TẮC TRƯỚC, đừng nghi sổ sách.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeedb;strokeColor=#c9913f;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="660" width="640" height="280" as="geometry" />
        </mxCell>
        <mxCell id="gh" value="&lt;b&gt;Giới hạn của bộ đo, nói ra để không ai đọc nhầm:&lt;/b&gt;  eval_ke_toan.py có 12 ca gieo lỗi, hiện 12/12 bắt được và 12/12 không báo oan. Nhưng n=12 nên khoảng tin cậy là &lt;b&gt;75,8%–100%&lt;/b&gt;. &quot;12/12&quot; không phải &quot;100%&quot;. Và đáp án của 12 ca do chính dự án đặt, nên bộ đo trả lời được &lt;i&gt;mã có làm đúng thứ ta định không&lt;/i&gt;, KHÔNG trả lời được &lt;i&gt;cách hiểu nghiệp vụ của ta có đúng không&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdfbf0;strokeColor=#c9b23f;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="1300" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p7" name="7. Bốn tầng mã">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t7" value="7. Bốn tầng mã, mũi tên chỉ đi xuống" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t7b" value="Lấy đúng theo tests/test_layering.py, file thi hành ranh giới này. Sổ tay và test mà khác nhau thì tin test." style="text;html=1;fontSize=13;fontColor=#5a5a5a;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b&gt;T4 · HTTP&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;src/api/&lt;br&gt;&lt;br&gt;Nhận request, xác thực, validate bằng pydantic, trả JSON&lt;br&gt;&lt;i&gt;Không chứa logic nghiệp vụ, không có phép tính nào&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="110" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="&lt;b&gt;T3 · Điều phối&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;src/agents/ · core/engine.py · core/knowledge.py&lt;br&gt;&lt;br&gt;Gọi model, định tuyến, ép đầu ra khớp JSON Schema, chạy vòng agentic&lt;br&gt;&lt;i&gt;Không tính tiền. Prompt thuộc T1, không định nghĩa tại chỗ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="230" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b&gt;T2 · Nghiệp vụ thuần&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;src/core/&lt;br&gt;&lt;br&gt;Mọi phép tính, mọi phép kiểm, mọi quyết định ghi dữ liệu&lt;br&gt;inventory · receivables · vat_catalog · period_diff · pricing · reporting · forecasting&lt;br&gt;&lt;i&gt;Không gọi LLM. Import tới agents/ hay api/ ở đây là SAI TẦNG&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=3;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="350" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b&gt;T1 · Nền&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;config · serving · schemas · prompts · utils · chunking&lt;br&gt;&lt;br&gt;Hằng số, dataclass, prompt, tiện ích thuần&lt;br&gt;&lt;i&gt;Không biết gì về ba tầng trên&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="490" width="760" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;strokeWidth=2;" edge="1" parent="1" source="L4" target="L3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;strokeWidth=2;" edge="1" parent="1" source="L3" target="L2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;strokeWidth=2;" edge="1" parent="1" source="L2" target="L1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="CẤM" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c0392b;strokeWidth=3;dashed=1;fontColor=#c0392b;fontStyle=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="L2" target="L4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="405" />
              <mxPoint x="960" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="why7" value="&lt;b&gt;Vì sao cần ranh giới này&lt;/b&gt;&lt;br&gt;&lt;br&gt;T2 chỉ phụ thuộc T1, nên test nghiệp vụ chạy &lt;b&gt;không cần GPU, không cần DB, không cần mạng&lt;/b&gt;. Đó cũng là chỗ gần như toàn bộ giá trị khách trả tiền nằm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chuyện đã xảy ra 03/08/2026:&lt;/b&gt; agents/agentic.py từng import ngược lên api/routes/chat.py chỉ để dùng một hàm đếm ngoặc trên chuỗi. Import đặt trong &lt;b&gt;thân hàm&lt;/b&gt; nên né được vòng lặp import lúc nạp module, và &lt;b&gt;không có gì báo&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Nó sống ở đó cho tới khi có người đối chiếu sơ đồ vẽ tay với bản đồ phụ thuộc sinh tự động. Lúc đó ARCHITECTURE_DIAGRAMS.md vẫn đang ghi &quot;mũi tên chỉ đi xuống&quot; — &lt;b&gt;một khẳng định sai&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;i&gt;test_layering.py biến câu đó thành thứ kiểm được.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdfbf0;strokeColor=#c9b23f;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="110" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;R4 — Một nguồn sự thật. Bốn nhóm đã từng lệch, mỗi lần lệch tốn một vòng đo hoặc một lỗ bảo mật.&lt;/b&gt;" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1200" height="26" as="geometry" />
        </mxCell>
        <mxCell id="r4a" value="&lt;b&gt;Định dạng workflow n8n&lt;/b&gt;&lt;br&gt;&lt;br&gt;workflow_schema.py là nguồn&lt;br&gt;prompts.py::CODER_SYSTEM dạy model&lt;br&gt;chat.py::_validate_workflow kiểm&lt;br&gt;&lt;br&gt;&lt;i&gt;Model từng được train trên Make.com, prompt bằng ví dụ n8n, đưa danh mục node của Body, rồi validate theo luật n8n. Bốn nguồn, ba định dạng.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="r4b" value="&lt;b&gt;Trường hệ thống tự bơm&lt;/b&gt;&lt;br&gt;&lt;br&gt;tool_planner.py::SYSTEM_DATA_FIELDS là nguồn&lt;br&gt;agentic.py::arguments_schema bỏ chúng khỏi grammar&lt;br&gt;render_tools() không quảng cáo chúng&lt;br&gt;&lt;br&gt;&lt;i&gt;Prompt từng dạy model điền sales trong khi grammar cấm. Model làm đúng lời dặn, viết mảng dài, tràn trần token, JSON cắt cụt, vòng lặp gãy.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="670" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="r4c" value="&lt;b&gt;Trần token&lt;/b&gt;&lt;br&gt;&lt;br&gt;MAX_DECISION_TOKENS&lt;br&gt;MAX_REPORT_TOKENS&lt;br&gt;MAX_WORKFLOW_TOKENS&lt;br&gt;là hằng số module; benchmark IMPORT thẳng&lt;br&gt;&lt;br&gt;&lt;i&gt;Benchmark từng đo ở 1024 trong khi production cấp 700. Mọi tỷ lệ cắt cụt đo được ĐẸP HƠN thứ khách nhận.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="670" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="r4d" value="&lt;b&gt;Tên biến môi trường&lt;/b&gt;&lt;br&gt;&lt;br&gt;dependencies.py đọc API_AUTH_TOKEN&lt;br&gt;compose ánh xạ API_AUTH_TOKEN: ${API_TOKEN}&lt;br&gt;test_deploy_config.py đọc CẢ HAI file và đối chiếu&lt;br&gt;&lt;br&gt;&lt;i&gt;Compose từng đặt API_TOKEN, mã đọc API_AUTH_TOKEN, và require_api_token BỎ QUA mọi kiểm tra khi biến rỗng. Brain triển khai theo README không kiểm token nào mà vẫn mở ra Internet.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1060" y="670" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="lech" value="&lt;b&gt;Nhóm thứ năm HIỆN ĐANG LỆCH:&lt;/b&gt; lược đồ DB. prompts.py::DB_SCHEMA, offline_training/db_schema.txt và SQL trong saas_api.py chưa khớp nhau. SCHEMA MAP của saas_api.py lệch 4/8 định danh so với Body: stock_quantity↔stock · sales↔sales_invoices · amount↔total · workspace_id↔warehouse_id. Body KHÔNG có khái niệm workspace nào cả." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fbeaea;strokeColor=#c0392b;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1340" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p8" name="8. Thuật toán &amp; feature engineering">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t8" value="8. Thuật toán và feature engineering của lớp tất định" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="t8b" value="Không có model nào trong trang này. Đây là chỗ mọi con số tài chính ra đời, và là chỗ R1 bảo vệ. Mỗi khối ghi: công thức, feature nó ăn vào, và chốt chặn của nó." style="text;html=1;fontSize=13;fontColor=#5a5a5a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1250" height="24" as="geometry" /></mxCell>

        <mxCell id="A1" value="&lt;b&gt;pricing.compute_quote&lt;/b&gt; — báo giá vận tải&lt;br&gt;&lt;br&gt;&lt;b&gt;Công thức, theo đúng thứ tự:&lt;/b&gt;&lt;br&gt;điều_chỉnh_nhiên_liệu = giá_nhà_xe × fuel_sensitivity × (dầu_nay/dầu_gốc − 1)&lt;br&gt;chi_phí_hiệu_chỉnh = giá_nhà_xe + điều_chỉnh_nhiên_liệu&lt;br&gt;phụ_phí = Σ(amount + chi_phí_hiệu_chỉnh × pct/100)&lt;br&gt;biên = max(chi_phí_hiệu_chỉnh × base_margin_pct/100, min_margin_amount)&lt;br&gt;&lt;b&gt;báo_giá = làm_tròn_1000đ(chi_phí_hiệu_chỉnh + phụ_phí + biên)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Feature ăn vào:&lt;/b&gt; carrier_cost · fuel_sensitivity (mặc định 0.35, khớp tỷ trọng nhiên liệu 35-40% của ngành) · fuel_baseline_price · current_fuel_price · surcharges[] · base_margin_pct · min_margin_amount&lt;br&gt;&lt;br&gt;&lt;b&gt;Chốt chặn:&lt;/b&gt; trả HAI khối. &lt;b&gt;quote&lt;/b&gt; đưa khách cuối được; &lt;b&gt;internal&lt;/b&gt; có biên, không bao giờ vào email gửi khách (P2). Thiếu giá dầu thì KHÔNG điều chỉnh và ghi warning, không đoán." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="630" height="290" as="geometry" /></mxCell>

        <mxCell id="A2" value="&lt;b&gt;carrier_selection&lt;/b&gt; — chấm điểm nhà xe, 6 tiêu chí có trọng số&lt;br&gt;&lt;br&gt;price 0.30 · proximity 0.20 · credit 0.20 · reliability 0.15 · discount 0.10 · tenure 0.05&lt;br&gt;&lt;br&gt;&lt;b&gt;Chuẩn hoá từng feature về [0,1] bằng ngưỡng hữu ích tối đa:&lt;/b&gt;&lt;br&gt;MAX_USEFUL_DISTANCE_KM = 60 — xa hơn coi như bất lợi tối đa&lt;br&gt;MAX_USEFUL_CREDIT_DAYS = 45&lt;br&gt;MAX_USEFUL_DISCOUNT_PCT = 20&lt;br&gt;MAX_USEFUL_TENURE_YEARS = 10&lt;br&gt;&lt;br&gt;&lt;b&gt;Chốt chặn:&lt;/b&gt; trả &lt;b&gt;breakdown&lt;/b&gt; truy vết từng tiêu chí, và &lt;b&gt;is_close_call&lt;/b&gt; khi khoảng cách hai hạng đầu nhỏ hơn 0.05 — tức chọn thế nào cũng được, đừng để người đọc tưởng có kết luận chắc.&lt;br&gt;&lt;br&gt;&lt;b&gt;⚠ Sáu trọng số và bốn ngưỡng trên do đội gốc TỰ ĐẶT, chưa ai xác nhận.&lt;/b&gt; Cách kiểm: lấy 10 ca khách đã chọn trong quá khứ, chạy lại, xem trùng mấy ca. Dưới 6/10 thì hỏi khách, rất có thể có tiêu chí thứ bảy không nằm trong mã." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="630" height="290" as="geometry" /></mxCell>

        <mxCell id="A3" value="&lt;b&gt;forecasting&lt;/b&gt; — dự báo nhu cầu RỜI RẠC, không phải chuỗi thời gian thường&lt;br&gt;&lt;br&gt;&lt;b&gt;Phân loại theo khung Syntetos-Boylan-Croston:&lt;/b&gt;&lt;br&gt;ADI = khoảng cách trung bình giữa hai lần CÓ nhu cầu — ngưỡng &lt;b&gt;1.32&lt;/b&gt;&lt;br&gt;CV² = bình phương hệ số biến thiên của LƯỢNG nhu cầu — ngưỡng &lt;b&gt;0.49&lt;/b&gt;&lt;br&gt;→ bốn chế độ: smooth · intermittent · erratic · lumpy&lt;br&gt;&lt;br&gt;&lt;b&gt;Dùng SBA chứ không dùng Croston gốc.&lt;/b&gt; Croston ước lượng DƯ khoảng 15-20% do cách đặt khoảng cách ở mẫu số lúc cập nhật (Syntetos &amp;amp; Boylan 2005). SBA là bản hiệu chỉnh.&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao không dùng ML:&lt;/b&gt; trên dữ liệu thưa, so sánh thực nghiệm cho thấy Croston sai số THẤP HƠN cả mô hình hồi quy ML tốt nhất. Dầu nhớt bán theo mã hàng là đúng dạng thưa." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="630" height="260" as="geometry" /></mxCell>

        <mxCell id="A4" value="&lt;b&gt;inventory.audit_inventory&lt;/b&gt; — soi sổ bằng BẤT ĐẲNG THỨC, không bằng suy đoán&lt;br&gt;&lt;br&gt;_check_balance — ĐK + Nhập − Xuất = CK&lt;br&gt;_check_negative — CK nhỏ hơn 0, xuất nhiều hơn số có&lt;br&gt;_check_zero_value — có số lượng mà giá trị bằng 0&lt;br&gt;_check_cost_drift — đơn giá tồn so với đơn giá xuất&lt;br&gt;_costing_method — bình quân đòi CẢ BA (xuất = tồn = BQ) trùng nhau, cộng ngưỡng biên giá tối thiểu 1%&lt;br&gt;_check_dead_and_slow — không xuất đơn vị nào suốt kỳ&lt;br&gt;_check_price_jump — giá nhập nhảy bậc&lt;br&gt;&lt;br&gt;&lt;b&gt;unit_cost_table + fill_missing_cogs&lt;/b&gt; bắc cầu giá vốn sang SaleLine, và ĐÁNH DẤU trong notes rằng đó là ước tính từ đơn giá xuất bình quân, không phải giá vốn ghi theo từng phiếu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="630" height="260" as="geometry" /></mxCell>

        <mxCell id="A5" value="&lt;b&gt;mcp_server&lt;/b&gt; — VAT&lt;br&gt;&lt;br&gt;VAT_STANDARD 0.10 · VAT_REDUCED 0.08&lt;br&gt;&lt;br&gt;Hợp lệ khi&lt;br&gt;|tính_lại − ghi_trên_hoá_đơn| ≤ &lt;b&gt;max(10đ, 0.1% × tổng)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dung sai đó đủ bắt lỗi đọc nhầm một chữ số, và không báo oan vì làm tròn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="410" height="180" as="geometry" /></mxCell>
        <mxCell id="A6" value="&lt;b&gt;tax_id&lt;/b&gt; — mã số thuế&lt;br&gt;&lt;br&gt;MST 10 số có chữ số cuối là &lt;b&gt;số kiểm tra&lt;/b&gt; tính từ 9 chữ số đầu, nên gõ sai một chữ số là phát hiện được &lt;b&gt;mà không cần tra cứu&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Chạy thật: 114 mã, &lt;b&gt;0 sai và 0 báo oan&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Nhận cả chi nhánh 13 số và số định danh cá nhân 12 số (TT 86/2024)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="720" width="410" height="180" as="geometry" /></mxCell>
        <mxCell id="A7" value="&lt;b&gt;period_diff&lt;/b&gt; — tìm chứng từ sửa hồi tố&lt;br&gt;&lt;br&gt;&lt;b&gt;Bất biến khai thác được:&lt;/b&gt; hai bản xuất CÙNG ngày bắt đầu, bản sau dài hơn, thì số xuất luỹ kế chỉ có thể &lt;b&gt;tăng hoặc giữ nguyên&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Giảm xuống là chuyện thời gian không cho phép, tức một chứng từ trong kỳ đã báo cáo đã bị sửa, xoá, hoặc huỷ ghi sổ.&lt;br&gt;&lt;br&gt;&lt;i&gt;Không bản báo cáo đơn lẻ nào cho thấy điều này.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="720" width="430" height="180" as="geometry" /></mxCell>

        <mxCell id="FE" value="&lt;b&gt;Feature engineering ở dự án này nghĩa là gì&lt;/b&gt;&lt;br&gt;&lt;br&gt;Không có bước học máy nào trên dữ liệu khách, nên feature ở đây là &lt;b&gt;đại lượng dẫn xuất từ sổ sách&lt;/b&gt; mà một phép kiểm hoặc một công thức ăn vào. Ba quy tắc chi phối toàn bộ:&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Chưa biết khác bằng không.&lt;/b&gt; Ô rỗng trả None. Gộp hai thứ này là cách nhanh nhất bịa ra một con số tài chính: báo cáo lãi lỗ sẽ coi mọi mặt hàng chưa nhập giá vốn là lãi 100%. reporting.build_report vì vậy tính cogs_coverage_pct, hạ confidence, và cảnh báo, thay vì điền 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Mỗi feature phải truy được về ô gốc.&lt;/b&gt; Mọi phát hiện mang theo evidence là các con số để chủ doanh nghiệp mở MISA đối chiếu tay. Feature không truy được thì không dùng để buộc tội sổ sách.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Ngưỡng do người đặt phải được khai là do người đặt.&lt;/b&gt; fuel_sensitivity 0.35, sáu trọng số nhà xe, ADI 1.32, CV² 0.49, ngưỡng tập trung 20%/50% — mỗi con số đều có nguồn: ngành, bài báo, hay đội gốc tự đặt. Loại thứ ba phải nói ra." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdfbf0;strokeColor=#c9b23f;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1290" height="250" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p9" name="9. Hạ tầng verification">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t9" value="9. Hạ tầng verification cho agent — ĐỀ XUẤT, chưa dựng" style="text;html=1;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="t9b" value="Luận điểm gốc: nếu agent không tự xác minh được việc mình làm, con người phải ngồi canh từng bước và trở thành nút thắt. ANSER mạnh một nửa và trống hẳn nửa kia." style="text;html=1;fontSize=13;fontColor=#5a5a5a;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1250" height="24" as="geometry" /></mxCell>

        <mxCell id="H1" value="NỬA ĐÃ CÓ — evals (mạnh hơn mức trung bình)" style="text;html=1;fontSize=17;fontStyle=1;align=left;fontColor=#3f7a3f;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="600" height="26" as="geometry" /></mxCell>
        <mxCell id="H1a" value="&lt;b&gt;1003 test&lt;/b&gt; · 43 file · chạy 107s, không cần GPU&lt;br&gt;&lt;b&gt;eval_ke_toan.py&lt;/b&gt; — 12 ca gieo lỗi vào chính sổ thật, 12/12 bắt được, 12/12 không báo oan&lt;br&gt;&lt;b&gt;guard_answer&lt;/b&gt; — mọi số từ 4 chữ số trở lên phải có trong dữ liệu gốc&lt;br&gt;&lt;b&gt;smoke_test_guided&lt;/b&gt; — kiểm ràng buộc có THI HÀNH, không chỉ dựng được&lt;br&gt;&lt;b&gt;test_layering&lt;/b&gt; — chặn phụ thuộc ngược tầng&lt;br&gt;&lt;b&gt;test_auth_bao_phu&lt;/b&gt; — hỏi TOÀN BỘ bảng route, không phải danh sách viết tay&lt;br&gt;&lt;b&gt;test_body_contract&lt;/b&gt; — đọc thẳng brain.ts của Body&lt;br&gt;&lt;b&gt;test_deploy_config&lt;/b&gt; — đối chiếu compose với tên biến mã đọc&lt;br&gt;&lt;b&gt;benchmark_v3 + compare_runs&lt;/b&gt; — so theo cặp bằng McNemar, có khoảng tin cậy Wilson" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="630" height="215" as="geometry" /></mxCell>

        <mxCell id="H2" value="NỬA ĐANG TRỐNG — the lever (agent không tự chạy được sản phẩm)" style="text;html=1;fontSize=17;fontStyle=1;align=left;fontColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="640" height="26" as="geometry" /></mxCell>
        <mxCell id="H2a" value="Agent &lt;b&gt;không&lt;/b&gt; bật được Brain rồi gọi /chat thật&lt;br&gt;Agent &lt;b&gt;không&lt;/b&gt; đọc được log của chính lượt nó vừa gọi&lt;br&gt;Agent &lt;b&gt;không&lt;/b&gt; nạp được file .xlsx rồi đọc findings trả về&lt;br&gt;Agent &lt;b&gt;không&lt;/b&gt; biết sản phẩm có những màn hình nào, ai đi tới đó bằng đường nào&lt;br&gt;Agent &lt;b&gt;không&lt;/b&gt; dựng lại được môi trường giống production&lt;br&gt;&lt;br&gt;&lt;b&gt;Hệ quả đo được trong chính phiên làm việc này:&lt;/b&gt; mỗi lần cần biết một thứ có chạy không, người phải gõ tay uvicorn rồi curl từng endpoint. Đó đúng là nút thắt, và nó giải thích vì sao một lớp như VLLMServerClient dựng xong, có 395 dòng test, mà tám tuần không ai phát hiện nó chưa được nối.&lt;br&gt;&lt;br&gt;&lt;i&gt;Test đơn vị chứng minh HÀM đúng. Chỉ chạy thật mới chứng minh ĐƯỜNG ĐI đúng.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbeaea;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="145" width="630" height="215" as="geometry" /></mxCell>

        <mxCell id="t9c" value="Đề xuất: ba mảnh, làm theo thứ tự rẻ trước" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="900" height="26" as="geometry" /></mxCell>

        <mxCell id="L1" value="&lt;b&gt;1. CLI điều khiển Brain&lt;/b&gt; — Build the Lever&lt;br&gt;&lt;br&gt;Một lệnh &lt;b&gt;anser&lt;/b&gt; gom đúng những thao tác hiện phải gõ tay:&lt;br&gt;&lt;br&gt;&lt;b&gt;anser up&lt;/b&gt; --profile minimal|full — bật Brain, đợi /health xanh&lt;br&gt;&lt;b&gt;anser ask&lt;/b&gt; &quot;câu hỏi&quot; — gọi /chat, chờ task xong, trả JSON&lt;br&gt;&lt;b&gt;anser tool&lt;/b&gt; inventory-audit --file x.xlsx&lt;br&gt;&lt;b&gt;anser logs&lt;/b&gt; --request-id ID — lấy đúng lượt vừa gọi&lt;br&gt;&lt;b&gt;anser verify&lt;/b&gt; — chạy trọn kịch bản CHAY_THU_NOI_BO rồi chấm&lt;br&gt;&lt;br&gt;&lt;b&gt;Bốn tính chất bắt buộc:&lt;/b&gt;&lt;br&gt;• đầu ra &lt;b&gt;máy đọc được&lt;/b&gt; (JSON), không phải chữ cho người&lt;br&gt;• thông báo lỗi &lt;b&gt;chỉ cách xử lý tiếp&lt;/b&gt;&lt;br&gt;• thao tác có thể gây ảnh hưởng hỗ trợ &lt;b&gt;--dry-run&lt;/b&gt;&lt;br&gt;• lệnh &lt;b&gt;ghép được&lt;/b&gt; với nhau&lt;br&gt;&lt;br&gt;&lt;i&gt;Phần lớn đã tồn tại rải rác: chay_thu_live.py, bat_lai_brain.py, các lệnh curl trong sổ tay. Việc là GOM lại, không phải viết mới.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#4a7fb5;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="425" width="420" height="400" as="geometry" /></mxCell>

        <mxCell id="L2" value="&lt;b&gt;2. Feature Map&lt;/b&gt; — bản đồ tính năng cho agent&lt;br&gt;&lt;br&gt;Một file trả lời ba câu, cho từng tính năng:&lt;br&gt;&lt;b&gt;có gì&lt;/b&gt; · &lt;b&gt;phục vụ việc gì&lt;/b&gt; · &lt;b&gt;đi tới đó bằng đường nào&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ví dụ một mục:&lt;br&gt;&lt;i&gt;Soi sổ tồn kho — kế toán tải .xlsx MISA lên màn hình Tồn kho của Body; Body gọi POST /tools/inventory-import; trả findings có 4 trường; trạng thái cần chú ý: file sai định dạng, file trùng, cột số không map được.&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Vì sao nó đáng:&lt;/b&gt; cộng với CLI, nó thành bộ nhớ cô đọng để agent hiểu sản phẩm mà không phải dò lại từ đầu mỗi phiên.&lt;br&gt;&lt;br&gt;&lt;b&gt;Phải bảo trì.&lt;/b&gt; Bản đồ cũ thì agent kiểm sai, và sai một cách tự tin. Gắn vào cùng PR với mọi thay đổi chạm giao diện hoặc endpoint." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#4a7fb5;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="425" width="420" height="400" as="geometry" /></mxCell>

        <mxCell id="L3" value="&lt;b&gt;3. Môi trường giả lập production&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đây là thứ chủ dự án đã nêu ngày 24/10, và nó cũng là lý do BR-04 chọn &lt;b&gt;hạ ctx&lt;/b&gt; thay vì tách vision sang tiến trình riêng: một tiến trình vLLM cộng vision nạp trong tiến trình thì &lt;b&gt;dựng lại dễ hơn hẳn&lt;/b&gt; hai dịch vụ GPU trên cùng một máy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Yêu cầu:&lt;/b&gt; cấu hình chốt ở BR-04 phải thành &lt;b&gt;runbook dựng lại được&lt;/b&gt;. Một cấu hình chỉ dựng được một lần bởi một người thì không dùng để thử lặp đi lặp lại.&lt;br&gt;&lt;br&gt;&lt;b&gt;Phía Body:&lt;/b&gt; chrome-devtools-mcp đã nối sẵn trong phiên này, dùng để agent mở trang, bấm, chụp màn hình, đọc console — tức là verification cho nửa giao diện mà Brain không với tới.&lt;br&gt;&lt;br&gt;&lt;i&gt;Giới hạn: Colab KHÔNG phục vụ traffic thật được (điều khoản Paid cấm web service), nên giả lập trên Colab chỉ để đo và thử, không phải để khách dùng.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#4a7fb5;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="425" width="420" height="400" as="geometry" /></mxCell>

        <mxCell id="LOOP" value="Vòng agent tự đóng được, sau khi có ba mảnh trên" style="text;html=1;fontSize=17;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="855" width="900" height="26" as="geometry" /></mxCell>
        <mxCell id="v1" value="đọc yêu cầu&lt;br&gt;&lt;i&gt;diễn giải lại&lt;br&gt;bằng lời của nó&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="895" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="v2" value="sửa mã" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="895" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="v3" value="&lt;b&gt;anser up&lt;/b&gt;&lt;br&gt;&lt;b&gt;anser verify&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f0fb;strokeColor=#4a7fb5;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="895" width="160" height="70" as="geometry" /></mxCell>
        <mxCell id="v4" value="đọc JSON kết quả&lt;br&gt;+ log theo request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f8fa;strokeColor=#9aa3ad;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="895" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="v5" value="đạt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdfbf0;strokeColor=#c9b23f;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="870" y="890" width="110" height="80" as="geometry" /></mxCell>
        <mxCell id="v6" value="&lt;b&gt;PR nhỏ, độc lập&lt;/b&gt;&lt;br&gt;kèm bằng chứng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="895" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="ve1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ve2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ve3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ve4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ve5" value="rồi" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a9a5a;fontSize=11;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ve6" value="chưa — sửa tiếp, KHÔNG hỏi người" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c0392b;fontSize=11;fontColor=#c0392b;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="v5" target="v2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="1010" /><mxPoint x="330" y="1010" /></Array></mxGeometry></mxCell>

        <mxCell id="RULE" value="&lt;b&gt;Hai điều phải nói rõ, nếu không trang này bị đọc sai&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Đây là ĐỀ XUẤT, chưa có dòng mã nào.&lt;/b&gt; Khác hẳn tám trang trước, vốn mô tả thứ đang chạy. Đừng trích trang này như mô tả hiện trạng.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Verification không thay việc hiểu mã.&lt;/b&gt; Nguồn gốc của ý tưởng này là một kỹ sư đã làm React Compiler ở Meta, tức người chạy nhiều agent song song lại chính là người có nền tảng kỹ thuật mạnh nhất. Luận điểm là &quot;làm cho AI tự kiểm chứng được mã của nó&quot;, &lt;b&gt;không&lt;/b&gt; phải &quot;không cần biết mã&quot;. Với ANSER thì càng đúng: R1 nói số tài chính ra từ mã tất định, và người duyệt PR vẫn phải đọc được phần tất định đó.&lt;br&gt;&lt;br&gt;&lt;b&gt;Chi phí (R3):&lt;/b&gt; ba mảnh trên đều là mã và tài liệu, chạy trên máy đã có. 0đ/tháng tăng thêm." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdeedb;strokeColor=#c9913f;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1320" height="170" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
