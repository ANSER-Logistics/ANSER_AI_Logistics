        <mxCell id="ex" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdeedb;strokeColor=#c9913f;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Nguồn công khai&lt;/b&gt;&lt;br&gt;&lt;br&gt;giá dầu · tỷ giá&lt;br&gt;tìm kiếm web&lt;br&gt;&lt;br&gt;&lt;b&gt;CHỈ ĐỌC, MỘT CHIỀU&lt;/b&gt;&lt;br&gt;không kèm tham số&lt;br&gt;chứa dữ liệu khách" vertex="1">
