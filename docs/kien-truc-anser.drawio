        </mxCell>
        <mxCell id="br4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Kho tri thức (RAG)&lt;/b&gt;&lt;br&gt;Chroma + BM25 + rerank · lọc theo workspace_id" vertex="1">
