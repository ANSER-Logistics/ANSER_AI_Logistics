        <mxCell id="ml" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#4a7fb5;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Model chạy local&lt;/b&gt;&lt;br&gt;&lt;br&gt;vLLM + Qwen3-8B AWQ&lt;br&gt;Qwen2.5-VL-3B (vision)&lt;br&gt;&lt;br&gt;&lt;i&gt;Không byte dữ liệu khách&lt;br&gt;nào rời hạ tầng&lt;/i&gt;" vertex="1">
