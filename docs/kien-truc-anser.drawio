          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="bd" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;fontSize=11;" target="br" value="HTTP + token">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="bd" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="n8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;fontSize=11;" target="br" value="HTTP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="br3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5a6570;" target="ml">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="br3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#c9913f;dashed=1;strokeWidth=2;fontSize=11;fontColor=#a9772a;" target="ex" value="nét đứt = ranh giới R2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#fdfbf0;strokeColor=#c9b23f;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Ranh giới sửa đổi&lt;/b&gt;&lt;br&gt;&lt;br&gt;Người làm Brain &lt;b&gt;không sửa repo Body&lt;/b&gt;. Chỉ được viết bản đặc tả thay đổi rồi dừng lại chờ người quyết định. AGENTS.md §1.&lt;br&gt;&lt;br&gt;Body chạy được khi Brain tắt: các tính năng AI hiện &quot;chưa cấu hình&quot;, phần còn lại dùng bình thường. Thiết kế như vậy có chủ đích, để Brain đổi hạ tầng mà Body không sửa dòng nào." vertex="1">
          <mxGeometry height="280" width="200" x="40" y="620" as="geometry" />
        </mxCell>
      </root>
