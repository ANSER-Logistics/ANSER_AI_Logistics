        <mxCell id="br1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Tầng API + định tuyến&lt;/b&gt;&lt;br&gt;/chat · /tools/* · /knowledge · /ocr&lt;br&gt;auth_guard gắn ở tầng router" vertex="1">
