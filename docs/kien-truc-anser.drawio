        <mxCell id="br2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dff0df;strokeColor=#5a9a5a;strokeWidth=2;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;LÕI TẤT ĐỊNH — KHÔNG LLM&lt;/b&gt;&lt;br&gt;inventory · receivables · vat_catalog · period_diff&lt;br&gt;tax_id · reporting · pricing · carrier_selection&lt;br&gt;forecasting · mcp_server&lt;br&gt;&lt;br&gt;&lt;i&gt;Chạy được bằng CPU. Đây là nơi gần như toàn bộ&lt;br&gt;giá trị khách trả tiền nằm.&lt;/i&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="590" y="370" as="geometry" />
        </mxCell>
        <mxCell id="br3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Vòng agentic&lt;/b&gt;&lt;br&gt;plan_tools (luật) → AgenticLoop → guard_answer" vertex="1">
