        <mxCell id="br5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacing=10;fontSize=12;" value="&lt;b&gt;Lớp MCP&lt;/b&gt; bọc đúng manifest /tools — không định nghĩa lại tool lần nào" vertex="1">
          <mxGeometry height="50" width="400" x="590" y="690" as="geometry" />
