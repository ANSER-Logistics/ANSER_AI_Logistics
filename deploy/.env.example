# deploy/.env.example — chép thành .env rồi điền.
#
#     cp .env.example .env
#
# ⚠️ .env chứa bí mật thật. KHÔNG commit. Kiểm tra .gitignore trước khi làm gì khác.

# --------------------------------------------------------------------------
# Model
# --------------------------------------------------------------------------
# Thư mục con trong MODELS_DIR chứa model text đã quantize (AWQ).
# Chép từ Drive xuống máy thuê: ANSER_AI_Logistics/anser-v3-awq
TEXT_MODEL_DIR=anser-v3-awq
MODELS_DIR=./models

# Cửa sổ ngữ cảnh. 32768 từ 28/10/2026 (BR-04, chủ dự án chốt): S2 đòi ctx 32k
# cho vòng agentic nạp lại kết quả tool mỗi bước. Đo trên L4: dựng được cùng
# vision, và nâng từ 8192 lên 32768 không làm request ngắn chạy kém song song —
# vLLM cấp KV theo token thật dùng. Xem BAO_CAO_BR04.md. config.py cùng mặc định.
TEXT_MAX_MODEL_LEN=32768

# Phần VRAM cho server text. Trên L4 22,5GB: 0.62 ≈ 14GB
# (weights AWQ ~6GB + KV-cache ~8GB). Còn ~25% cho vision, ~13% cho hệ thống.
TEXT_GPU_FRACTION=0.62

# Lượng tử hoá / dtype của vllm-text. RỖNG = để vLLM tự nhận từ config.json của
# model (AWQ -> nhân awq_marlin), giống đường trong tiến trình và giống phép đo.
# Chỉ ép khi nhân tự chọn lỗi trên GPU lạ: TEXT_QUANTIZATION=awq + TEXT_DTYPE=half.
TEXT_QUANTIZATION=
TEXT_DTYPE=

# --------------------------------------------------------------------------
# Vision (Giai đoạn 3b — chỉ dùng khi chạy `--profile vision`)
# Mặc định Qwen3-VL-2B (Apache-2.0). Qwen2.5-VL-3B (mặc định cũ) mang giấy phép
# `qwen-research`, chỉ cho nghiên cứu và đánh giá: KHÔNG đặt lại làm mặc định.
# 0,25 x 24GB = 6GB cho trọng số ~4,3GB + kích hoạt + KV: ƯỚC LƯỢNG, compose chưa
# từng chạy. Model lớn hơn (Qwen3-VL-4B ~8,9GB) cần nâng VISION_GPU_FRACTION và hạ
# TEXT_GPU_FRACTION, hoặc dùng GPU riêng cho vision.
# --------------------------------------------------------------------------
VISION_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
VISION_MAX_MODEL_LEN=4096
VISION_GPU_FRACTION=0.25

# Brain gọi vllm-vision qua HTTP (#14). ĐẶT CÙNG LÚC với `--profile vision`:
#     VLLM_VISION_BASE_URL=http://vllm-vision:8002
# Để trống = vision tắt có tuyên bố (`/health`: vision_backend "none") — đúng khi
# không bật profile. Đặt mà không bật profile thì /health báo `degraded`, vì
# Brain gọi một container không chạy.
VLLM_VISION_BASE_URL=

# --------------------------------------------------------------------------
# Điều tiết tải — PHẢI đo lại trên máy thật (README §5)
# --------------------------------------------------------------------------
# 4 là điểm khởi đầu thận trọng, KHÔNG phải con số đã đo. Số đúng phụ thuộc
# KV-cache còn trống, mà cái đó phụ thuộc độ dài prompt thực tế.
TEXT_MAX_CONCURRENT=4
TEXT_MAX_QUEUE=16
TEXT_WAIT_TIMEOUT_S=20

# Ngưỡng p95 của một lời gọi model (NFR-03), hai ngưỡng — 28/10/2026.
# ms/token đo sức khoẻ server (BR-04 đo ~40 trên L4); tổng ms là thứ người dùng
# cảm thấy, câu trả lời dài vượt nó là bình thường. Xem src/core/nguong_p95.py.
#
# Từ #9 (17/11/2026) compose truyền cả bốn biến vào `brain`, và /health trả
# khối `p95` tính trên P95_CUA_SO lượt gần nhất (trong bộ nhớ — khởi động lại
# là rỗng). Dưới P95_MAU_TOI_THIEU lượt BIẾT số token thì "không đủ dữ liệu".
# CHỈ ms/token "chưa đạt" hạ `degraded`; tổng ms chỉ báo cáo.
# `offline_training/do_ngan_sach_ctx.py` vẫn đọc hai ngưỡng từ env phiên Colab.
P95_MS_MOI_TOKEN=60
P95_NGUONG_MS=5000
P95_CUA_SO=200
P95_MAU_TOI_THIEU=30

# --------------------------------------------------------------------------
# Bí mật
# --------------------------------------------------------------------------
# Token Body dùng để gọi Brain. Sinh bằng: openssl rand -hex 32
API_TOKEN=

# Khoá giữa Brain và vLLM. Hai server chỉ nghe trên 127.0.0.1 nên có thể để
# trống; điền nếu sau này tách sang máy khác.
VLLM_API_KEY=

# Postgres (Neon). Để trống thì Brain chạy SQLite in-memory.
DATABASE_URL=

# Token tunnel: Cloudflare Zero Trust > Networks > Tunnels > tạo tunnel > copy token.
CLOUDFLARE_TUNNEL_TOKEN=

# --------------------------------------------------------------------------
# Nối với n8n và với Body
# --------------------------------------------------------------------------
# BỐN BIẾN DƯỚI ĐÂY ĐỔI HÀNH VI THẬT, và trước 04/11/2026 không có mặt ở file
# này lẫn docker-compose.yml. Nghĩa là không có cách nào biết tên chúng ngoài
# việc đọc mã nguồn — và nếu có đặt trong .env thì cũng không tới được container.
#
# Để trống = đúng hành vi hiện tại. Không có biến nào trong đây bật sẵn thứ gì.

# Webhook n8n nhận yêu cầu báo giá vận tải.
#
# ĐỂ TRỐNG LÀ NGHIỆP VỤ ƯU TIÊN 1 KHÔNG CHẠY. Nhánh LOGISTICS sẽ trả lời người
# dùng "Hệ thống báo giá chưa được nối với n8n (thiếu N8N_QUOTE_WEBHOOK_URL)".
# Câu đó nói đúng tên biến, nhưng người vận hành không tìm thấy nó ở đâu cả —
# đó chính là lý do dòng này tồn tại.
N8N_QUOTE_WEBHOOK_URL=

# Phạm vi kho tri thức của Brain. PHẢI KHỚP `BRAIN_KB_WORKSPACE` bên Body.
#
# Lệch thì không có lỗi nào: Brain tra một kho, Body nạp tài liệu vào kho khác,
# và câu trả lời trông như "không tìm thấy tài liệu". Xem cảnh báo đầu
# src/api/routes/knowledge.py về việc hợp đồng khách A lọt sang khách B.
KB_WORKSPACE_ID=default

# Thư mục workflow n8n THẬT của Body, để danh mục node và typeVersion lấy từ
# n8n của họ (#20). Bên Body: `frontend/n8n-workflows/` của ANSER-logistics-body.
#
# Trước khi `docker compose up`, tải về (chỉ đọc repo Body):
#     python offline_training/dong_bo_n8n_body.py tai     # -> deploy/n8n-body/
# Compose mount thư mục đó ở /app/n8n-body và mặc định trỏ biến này vào đó, nên
# để trống ở đây là ĐÚNG. Chỉ điền khi muốn trỏ chỗ khác.
#
# Chưa tải thì Brain dùng catalog dự phòng và ghi log cảnh báo: workflow sinh ra
# vẫn hợp lệ về cấu trúc nhưng typeVersion có thể không khớp n8n của Body, và lỗi
# đó chỉ lộ ra lúc import. Kiểm lệch: `python offline_training/dong_bo_n8n_body.py kiem`.
N8N_TEMPLATES_DIR=

# Webhook Brain gọi VỀ Body khi một lượt chat xong.
#
# ĐỌC KỸ TRƯỚC KHI ĐIỀN: đặt URL là bật một lời gọi ra ngoài mang theo `result`
# = câu trả lời của AI, mà câu trả lời đó có thể chứa tên khách, mã số thuế, số
# công nợ. Để trống là TẮT.
#
# Chưa đặt API_TOKEN thì lời gọi này đi KHÔNG kèm token xác thực (có cảnh báo
# trong log) — cố ý, xem src/api/routes/chat.py::_webhook_headers.
BODY_CALLBACK_URL=

# --------------------------------------------------------------------------
# Chỉ dùng khi Brain TỰ NẠP model (không phải cách triển khai này)
# --------------------------------------------------------------------------
# Cách triển khai trong compose cho vLLM chạy ở container riêng, nên Brain không
# nạp model nào (ENV=SERVER) và KHÔNG cần TEXT_MODEL_ID. Ghi ra đây vì AGENTS.md
# §R5 liệt kê nó đầu danh sách và nó CỐ Ý không có mặc định — ai chạy chế độ
# trong-tiến-trình mà quên đặt sẽ bị ModelEngine báo lỗi, chứ không lặng lẽ nạp
# nhầm model. Để dạng chú thích, không phải dòng `KEY=`, vì compose không dùng.
#
#   TEXT_MODEL_ID=/duong/dan/toi/anser-v3-awq

# --------------------------------------------------------------------------
# Núm tinh chỉnh code đọc nhưng compose CHƯA truyền vào container (#38)
# --------------------------------------------------------------------------
# Soát 17/11/2026: src/ đọc 45 biến môi trường; 19 biến dưới đây không có ở file
# này lẫn docker-compose.yml. Mỗi biến có mặc định an toàn trong code, nên
# không đặt gì thì Brain vẫn chạy đúng như hôm nay.
#
# Để dạng CHÚ THÍCH, không phải dòng `KEY=`, vì compose chỉ chuyển vào container
# `brain` những biến liệt kê trong khối `environment:` của nó. Đặt các biến này
# trong .env KHÔNG có tác dụng gì với cách triển khai compose. Muốn đổi thì thêm
# biến vào `environment:` của `brain` (và vào file này dạng `KEY=`), hoặc đặt
# thẳng trong môi trường khi chạy uvicorn ngoài compose.
# `tests/test_deploy_config.py::test_moi_khoa_env_mau_den_duoc_mot_cho` khoá
# đúng điều đó: một dòng `KEY=` ở đây mà compose không truyền là test đỏ.
#
# Giá trị ghi sau dấu `=` là MẶC ĐỊNH THẬT trong code (đọc từ code, không đoán).

# --- Vận hành chung ---
# Mức log của Python logging: DEBUG / INFO / WARNING / ERROR. (src/api/main.py)
#   LOG_LEVEL=INFO
#
# Danh sách origin được phép gọi qua trình duyệt (CORS), cách nhau bởi dấu phẩy.
# Chỉ áp cho lời gọi TỪ TRÌNH DUYỆT; Body gọi Brain từ server thì không cần.
# Đổi khi có giao diện web gọi thẳng Brain từ một tên miền khác. (src/api/main.py)
#   ALLOWED_ORIGINS=http://localhost:3000
#
# Tắt bớt phần nào khi khởi động: `full` (mặc định, bật hết) / `text-only` (tắt
# vision) / `minimal` (tắt model text; vision không bị chặn bởi giá trị này).
# /health trả giá trị này ở `runtime_profile`.
# (src/api/dependencies.py)
#   RUNTIME_PROFILE=full
#
# Trần kích thước tệp tải lên, tính bằng byte (ảnh hoá đơn, tài liệu kho tri
# thức). 5242880 = 5 MiB. Tệp lớn hơn bị từ chối. (src/core/config.py)
#   MAX_UPLOAD_BYTES=5242880
#
# Số giây giữ kết quả một tác vụ chạy nền trong Redis. 86400 = 24 giờ. Body hỏi
# kết quả sau thời hạn này thì nhận "Task not found". (src/core/engine.py)
#   TASK_TTL_S=86400

# --- Hội thoại ---
# Số lượt chat cũ tối đa đưa lại vào prompt (6 = 3 cặp hỏi-đáp). Tăng thì model
# nhớ xa hơn nhưng mỗi request tốn ngữ cảnh hơn. (src/core/engine.py)
#   MAX_HISTORY_TURNS=6
#
# Mỗi lượt cũ dài hơn số ký tự này thì bị cắt trước khi đưa vào prompt.
# (src/core/engine.py)
#   MAX_HISTORY_CHARS=1200

# --- Model text ---
# Mức phạt lặp từ khi model viết tự do (diễn giải). Mặc định 1,25 đang được đo
# lại (BR-05): đổi để ĐO, đừng đổi mặc định khi chưa có số. (src/core/serving.py)
#   TEXT_REPETITION_PENALTY=1.25

# --- Kho tri thức (RAG) ---
# Model nhúng (embedder) và model xếp hạng lại (reranker). Đổi model là phải nạp
# lại toàn bộ kho, vì vector cũ không so được với vector của model mới.
# KHÔNG dùng reranker giấy phép phi thương mại (ví dụ jina-reranker-v2).
# (src/core/knowledge.py; config.py cũng đọc hai tên này, xem #38)
#   KB_EMBEDDER_ID=BAAI/bge-m3
#   KB_RERANKER_ID=namdp-ptit/ViRanker
#
# Ngưỡng điểm liên quan, từ 0 đến 1 (sau sigmoid của reranker). Đoạn tài liệu
# điểm thấp hơn ngưỡng bị loại khỏi câu trả lời. Đổi khi có số đo kho (#34).
# (src/core/knowledge.py)
#   KB_RELEVANCE_THRESHOLD=0.5
#
# Thiết bị chạy embedder và reranker: `cpu` hoặc `cuda`. Mặc định CPU để nhường
# VRAM cho model text và vision; truy vấn RAG thưa nên chậm hơn một chút là
# chấp nhận được. (src/core/knowledge.py)
#   KB_DEVICE=cpu

# --- Điều tiết tải cho vision ---
# Cùng nghĩa với TEXT_MAX_CONCURRENT / _MAX_QUEUE / _WAIT_TIMEOUT_S ở trên nhưng
# cho model đọc ảnh. Tên đầy đủ được code ghép bằng f-string
# (`f"ANSER_{name.upper()}_..."`, src/core/serving.py::guard_from_env) nên tìm
# tên trong code sẽ không ra. Khác bên text: compose không ánh xạ ba biến này.
#   ANSER_VISION_MAX_CONCURRENT=4
#   ANSER_VISION_MAX_QUEUE=16
#   ANSER_VISION_WAIT_TIMEOUT_S=20

# --- Báo giá: tuổi giá dầu (AGENTS.md §3.1c) ---
# Giá dầu dùng để điều chỉnh báo giá cũ từ FUEL_PRICE_WARN_DAYS ngày thì báo giá
# có cảnh báo; cũ từ FUEL_PRICE_MAX_DAYS ngày thì /tools/quote trả 422 (từ chối
# báo giá). RỖNG = dùng mặc định trong code (2 và 7 ngày; mặc định chỉ sống ở
# `src/core/pricing.py`, không lặp ở đây). Phải thoả 1 <= WARN <= MAX; giá trị
# hỏng thì dịch vụ không khởi động. Compose truyền cả hai vào container `brain`
# từ 17/11/2026 (trước đó đặt ở đây không có tác dụng). Không phải bí mật.
FUEL_PRICE_WARN_DAYS=
FUEL_PRICE_MAX_DAYS=

# --- Ghi số đo (metrics) ---
# 1 = ghi cả NỘI DUNG tin nhắn vào file số đo. Nội dung là dữ liệu khách hàng:
# để 0 trừ khi chủ dự án đồng ý, và không bao giờ gửi file đó ra ngoài (R2).
# (src/core/metrics.py)
#   AI_METRICS_LOG_CONTENT=0
#
# Đường dẫn file số đo (JSONL). Mặc định: src/data/ai_metrics_log.jsonl trong
# thư mục mã. Đặt RỖNG để tắt hẳn việc ghi. (src/core/metrics.py)
#   AI_METRICS_PATH=src/data/ai_metrics_log.jsonl

# HMAC từng yêu cầu (A6, src/api/hmac_auth.py): off | log | enforce. Khoá mỗi bên gọi một biến, từ 32 ký tự ngẫu nhiên; KHÔNG commit giá trị thật.
API_HMAC_MODE=off
API_HMAC_KEY_BODY=
API_HMAC_KEY_N8N=

# Thăm dò model mỗi N giây (rỗng = 60; 0 = tắt) và giới hạn chuỗi trong grammar workflow (rỗng/0 = tắt; chỉ bật 600 sau khi đo trên vLLM thật).
LLM_PROBE_INTERVAL_S=
WORKFLOW_GRAMMAR_MAX_STRING=
