# deploy/.env.example — chép thành .env rồi điền.
#
#     cp .env.example .env
#
# ⚠️ .env chứa bí mật thật. KHÔNG commit. Kiểm tra .gitignore trước khi làm gì khác.

# --------------------------------------------------------------------------
# Model
# --------------------------------------------------------------------------
# Thư mục con trong MODELS_DIR chứa model text đã quantize (AWQ).
# Chép từ Drive xuống máy thuê: ANSER_AI_Logistics/anser-v3-awq
TEXT_MODEL_DIR=anser-v3-awq
MODELS_DIR=./models

# Cửa sổ ngữ cảnh. 32768 từ 28/10/2026 (BR-04, chủ dự án chốt): S2 đòi ctx 32k
# cho vòng agentic nạp lại kết quả tool mỗi bước. Đo trên L4: dựng được cùng
# vision, và nâng từ 8192 lên 32768 không làm request ngắn chạy kém song song —
# vLLM cấp KV theo token thật dùng. Xem BAO_CAO_BR04.md. config.py cùng mặc định.
TEXT_MAX_MODEL_LEN=32768

# Phần VRAM cho server text. Trên L4 22,5GB: 0.62 ≈ 14GB
# (weights AWQ ~6GB + KV-cache ~8GB). Còn ~20% cho vision, ~18% cho hệ thống.
TEXT_GPU_FRACTION=0.62

# --------------------------------------------------------------------------
# Vision (Giai đoạn 3b — chỉ dùng khi chạy `--profile vision`)
# --------------------------------------------------------------------------
VISION_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
VISION_MAX_MODEL_LEN=4096
VISION_GPU_FRACTION=0.20

# --------------------------------------------------------------------------
# Điều tiết tải — PHẢI đo lại trên máy thật (README §5)
# --------------------------------------------------------------------------
# 4 là điểm khởi đầu thận trọng, KHÔNG phải con số đã đo. Số đúng phụ thuộc
# KV-cache còn trống, mà cái đó phụ thuộc độ dài prompt thực tế.
TEXT_MAX_CONCURRENT=4
TEXT_MAX_QUEUE=16
TEXT_WAIT_TIMEOUT_S=20

# Ngưỡng p95 của một lời gọi model (NFR-03), hai ngưỡng — 28/10/2026.
# ms/token đo sức khoẻ server (BR-04 đo ~40 trên L4); tổng ms là thứ người dùng
# cảm thấy, câu trả lời dài vượt nó là bình thường. Xem src/core/nguong_p95.py.
#
# CHỈ CÓ TÁC DỤNG VỚI SCRIPT ĐO, không với service đang chạy (soát 04/11/2026).
# `offline_training/do_ngan_sach_ctx.py` đọc chúng từ env của phiên Colab và
# dùng để kết luận đạt/vượt. Còn `docker-compose.yml` KHÔNG truyền hai biến này
# vào container `brain`, và trong `src/` cũng không chỗ nào so p95 với ngưỡng —
# `metrics.py` tính ra con số p95 nhưng không kết luận gì.
#
# Nên đặt chúng ở đây rồi khởi động lại service thì KHÔNG có gì đổi. Nối ngưỡng
# vào /health là việc riêng trên bảng kanzo; để nguyên đến lúc đó, nhưng nói
# thật rằng hiện giờ chúng dùng cho phép đo.
P95_MS_MOI_TOKEN=60
P95_NGUONG_MS=5000

# --------------------------------------------------------------------------
# Bí mật
# --------------------------------------------------------------------------
# Token Body dùng để gọi Brain. Sinh bằng: openssl rand -hex 32
API_TOKEN=

# Khoá giữa Brain và vLLM. Hai server chỉ nghe trên 127.0.0.1 nên có thể để
# trống; điền nếu sau này tách sang máy khác.
VLLM_API_KEY=

# Postgres (Neon). Để trống thì Brain chạy SQLite in-memory.
DATABASE_URL=

# Token tunnel: Cloudflare Zero Trust > Networks > Tunnels > tạo tunnel > copy token.
CLOUDFLARE_TUNNEL_TOKEN=

# --------------------------------------------------------------------------
# Nối với n8n và với Body
# --------------------------------------------------------------------------
# BỐN BIẾN DƯỚI ĐÂY ĐỔI HÀNH VI THẬT, và trước 04/11/2026 không có mặt ở file
# này lẫn docker-compose.yml. Nghĩa là không có cách nào biết tên chúng ngoài
# việc đọc mã nguồn — và nếu có đặt trong .env thì cũng không tới được container.
#
# Để trống = đúng hành vi hiện tại. Không có biến nào trong đây bật sẵn thứ gì.

# Webhook n8n nhận yêu cầu báo giá vận tải.
#
# ĐỂ TRỐNG LÀ NGHIỆP VỤ ƯU TIÊN 1 KHÔNG CHẠY. Nhánh LOGISTICS sẽ trả lời người
# dùng "Hệ thống báo giá chưa được nối với n8n (thiếu N8N_QUOTE_WEBHOOK_URL)".
# Câu đó nói đúng tên biến, nhưng người vận hành không tìm thấy nó ở đâu cả —
# đó chính là lý do dòng này tồn tại.
N8N_QUOTE_WEBHOOK_URL=

# Phạm vi kho tri thức của Brain. PHẢI KHỚP `BRAIN_KB_WORKSPACE` bên Body.
#
# Lệch thì không có lỗi nào: Brain tra một kho, Body nạp tài liệu vào kho khác,
# và câu trả lời trông như "không tìm thấy tài liệu". Xem cảnh báo đầu
# src/api/routes/knowledge.py về việc hợp đồng khách A lọt sang khách B.
KB_WORKSPACE_ID=default

# Thư mục workflow n8n THẬT của Body, để danh mục node và typeVersion lấy từ
# n8n của họ (#20). Bên Body: `frontend/n8n-workflows/` của ANSER-logistics-body.
#
# Trước khi `docker compose up`, tải về (chỉ đọc repo Body):
#     python offline_training/dong_bo_n8n_body.py tai     # -> deploy/n8n-body/
# Compose mount thư mục đó ở /app/n8n-body và mặc định trỏ biến này vào đó, nên
# để trống ở đây là ĐÚNG. Chỉ điền khi muốn trỏ chỗ khác.
#
# Chưa tải thì Brain dùng catalog dự phòng và ghi log cảnh báo: workflow sinh ra
# vẫn hợp lệ về cấu trúc nhưng typeVersion có thể không khớp n8n của Body, và lỗi
# đó chỉ lộ ra lúc import. Kiểm lệch: `python offline_training/dong_bo_n8n_body.py kiem`.
N8N_TEMPLATES_DIR=

# Webhook Brain gọi VỀ Body khi một lượt chat xong.
#
# ĐỌC KỸ TRƯỚC KHI ĐIỀN: đặt URL là bật một lời gọi ra ngoài mang theo `result`
# = câu trả lời của AI, mà câu trả lời đó có thể chứa tên khách, mã số thuế, số
# công nợ. Để trống là TẮT.
#
# Chưa đặt API_TOKEN thì lời gọi này đi KHÔNG kèm token xác thực (có cảnh báo
# trong log) — cố ý, xem src/api/routes/chat.py::_webhook_headers.
BODY_CALLBACK_URL=

# --------------------------------------------------------------------------
# Chỉ dùng khi Brain TỰ NẠP model (không phải cách triển khai này)
# --------------------------------------------------------------------------
# Cách triển khai trong compose cho vLLM chạy ở container riêng, nên Brain không
# nạp model nào (ENV=SERVER) và KHÔNG cần TEXT_MODEL_ID. Ghi ra đây vì AGENTS.md
# §R5 liệt kê nó đầu danh sách và nó CỐ Ý không có mặc định — ai chạy chế độ
# trong-tiến-trình mà quên đặt sẽ bị ModelEngine báo lỗi, chứ không lặng lẽ nạp
# nhầm model. Để dạng chú thích, không phải dòng `KEY=`, vì compose không dùng.
#
#   TEXT_MODEL_ID=/duong/dan/toi/anser-v3-awq
